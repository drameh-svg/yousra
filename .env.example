# Copy to .env. Local development works without keys using clearly labelled sample data.
APP_ORIGIN=http://localhost:3000
PORT=3000
STORAGE=local
AUTH_MODE=local
ALLOW_LOCAL_PRODUCTION=false
# Keep the local test database OUTSIDE the project folder: `next dev` watches project files, and
# SQLite writes on every request would trigger an endless reload loop.
LOCAL_DB_PATH=/tmp/yousra-local.sqlite

# Production: STORAGE=supabase and AUTH_MODE=supabase; run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this in NEXT_PUBLIC_ variables or the frontend.
# Preferred modern server key; legacy SERVICE_ROLE_KEY remains supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (optional, opt-in via DISCOVERY_PROVIDER/VISION_PROVIDER): product discovery with Claude web search + garment photo analysis.
# Get a key at console.anthropic.com. Web search must be enabled for the org in the Console.
# Cost guide: ~$0.01 per web search (max CLAUDE_MAX_SEARCHES per new query, cached SEARCH_TTL_HOURS)
# plus Haiku 5.5 tokens (fractions of a cent per product photo).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Optional: a stronger model just for finding products, e.g. claude-sonnet-5-5
CLAUDE_SEARCH_MODEL=
CLAUDE_MAX_SEARCHES=3
CLAUDE_SEARCH_DAILY_LIMIT=60
CLAUDE_SEARCH_TOTAL_LIMIT=1500
CLAUDE_VISION_DAILY_LIMIT=400
CLAUDE_VISION_TOTAL_LIMIT=10000
# serper (default when SERPER_API_KEY is set) | claude | both (Claude picks + Serper images/prices)
DISCOVERY_PROVIDER=
# gemini (default when GEMINI_API_KEY is set) | claude | none
VISION_PROVIDER=

# Optional fallback: Google Shopping + organic product discovery. Use a free trial, no top-ups.
SERPER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Atomic counters persist across restarts (limits are call counts, not dollar budgets).
SERPER_DAILY_LIMIT=40
SERPER_TOTAL_LIMIT=200
GEMINI_DAILY_LIMIT=60
GEMINI_TOTAL_LIMIT=300
SEARCH_TTL_HOURS=6
MAX_CANDIDATES=12
# Optional JSON mapping EXACT retailer hostnames to approved affiliate URL templates.
# Only add templates supplied/approved by the affiliate program. {url} is URL-encoded.
# AFFILIATE_RULES={"retailer.example":"https://approved-network.example/click?url={url}"}
AFFILIATE_RULES={}

# Stock display: false (default) hides only products confirmed sold out; true shows only products
# confirmed in stock within 30 minutes (hides retailers that block automated checks, e.g. Amazon/SHEIN).
REQUIRE_VERIFIED_STOCK=false

# Team access to /admin/reviews (journey survey results + CSV) and /api/admin/metrics.
ADMIN_EMAILS=
ADMIN_USER_IDS=

# Speed & analysis (all optional; defaults shown)
# Products analysed in parallel per step. Keep under your Gemini free-tier requests-per-minute.
ANALYSIS_CONCURRENCY=5
# Re-check retailer facts after this many hours. Vision results are cached permanently and not re-run.
ANALYSIS_TTL_HOURS=168
# Photos sent per product (main + back/detail shots) and their max size in pixels.
VISION_MAX_IMAGES=3
VISION_IMAGE_PX=768
ROBOTS_TTL_HOURS=12
# Feed exploration: every Nth slot shows a well-verified piece outside the shopper's usual taste (0 = off).
EXPLORE_EVERY=8
# Shopper coverage labels needed (in agreement) before they override the AI's verdict. One "not modest" always excludes.
HUMAN_LABEL_MIN=2

# First-load speed (optional; defaults shown)
# Start the first feed searches as soon as onboarding finishes / a feed opens (false = off).
FEED_PREWARM=true
# Max wait for a slow retailer page during a search; slower pages finish in the background.
ENRICH_WAIT_MS=2500
# How long the product catalog is reused in memory between reads.
CATALOG_CACHE_MS=15000
