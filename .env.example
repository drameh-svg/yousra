# Copy to .env. Local development works without keys using clearly labelled sample data.
APP_ORIGIN=http://localhost:3000
PORT=3000
STORAGE=local
AUTH_MODE=local
ALLOW_LOCAL_PRODUCTION=false
LOCAL_DB_PATH=./data/yousra.sqlite

# Production: STORAGE=supabase and AUTH_MODE=supabase; run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this in NEXT_PUBLIC_ variables or the frontend.
# Preferred modern server key; legacy SERVICE_ROLE_KEY remains supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Broad Google Shopping + organic product discovery. Use a free trial, no top-ups.
SERPER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Atomic counters persist across restarts (limits are call counts, not dollar budgets).
SERPER_DAILY_LIMIT=40
SERPER_TOTAL_LIMIT=200
GEMINI_DAILY_LIMIT=60
GEMINI_TOTAL_LIMIT=300
SEARCH_TTL_HOURS=6
MAX_CANDIDATES=12
# Optional JSON mapping EXACT retailer hostnames to approved affiliate URL templates.
# Only add templates supplied/approved by the affiliate program. {url} is URL-encoded.
# AFFILIATE_RULES={"retailer.example":"https://approved-network.example/click?url={url}"}
AFFILIATE_RULES={}
